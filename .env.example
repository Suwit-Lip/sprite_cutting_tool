PORT=8080

# Default folders — Windows path (for running the Go binary directly on Windows).
# Docker users: see docker-compose.yml — paths inside the container are /data/input etc.
INPUT_DIR=D:\Game Asset\input
OUTPUT_DIR=D:\Game Asset\output
PROMPTS_FILE=D:\Game Asset\prompts.json
PRESETS_FILE=D:\Game Asset\presets.json

# Python interpreter the Go backend invokes for the engine scripts.
# On Windows this is typically "python" or an absolute path to python.exe.
# Inside the Docker image it is "python3".
PYTHON_BIN=python

# LLM — active provider
LLM_PROVIDER=gemini             # gemini | openai
LLM_MODEL=gemini-2.5-flash      # gemini: gemini-2.5-flash | openai: gpt-4.1-nano

# Per-provider keys. Both can be set; LLM_PROVIDER picks which one to use.
# LLM_API_KEY (legacy) is honored as a fallback if neither of these is set.
GEMINI_API_KEY=
OPENAI_API_KEY=

# Default base prompt. For long multi-line prompts, point at a file:
LLM_DEFAULT_PROMPT_FILE=D:\Game Asset\default_prompt.txt
# Or set it inline (env files don't handle multi-line well):
# LLM_DEFAULT_PROMPT=

# Upload
MAX_UPLOAD_MB=50
